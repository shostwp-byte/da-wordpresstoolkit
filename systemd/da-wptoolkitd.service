[Unit]
Description=DirectAdmin WordPress Toolkit & Core Integrity Shield Daemon (da-wptoolkitd)
Documentation=https://github.com/shostwp-byte/da-wordpresstoolkit
After=network.target mariadb.service mysqld.service directadmin.service
Wants=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/da-wptoolkit serve
Restart=always
RestartSec=2s

# Protect WordPress Core Integrity Shield daemon from host OOM Killer
OOMScoreAdjust=-850
LimitNOFILE=65535
UMask=0022

# Systemd sandboxing & DirectAdmin / CloudLinux compatibility
# Note: PrivateTmp must remain 'no' so da-wptoolkitd and WP-CLI can reach DirectAdmin CustomBuild /tmp/mysql.sock.
# NoNewPrivileges must remain 'no' so CloudLinux CageFS wrappers (/usr/sbin/cagefs_enter) work after dropping UID/GID.
NoNewPrivileges=no
PrivateTmp=no
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=da-wptoolkitd

[Install]
WantedBy=multi-user.target
